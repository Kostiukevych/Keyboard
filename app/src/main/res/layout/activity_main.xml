<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_title"
            android:textColor="@color/neon_blue"
            android:textSize="26sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_neon_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tv_status_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="3dp"
                android:textColor="#E0F7FF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_status_access"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="3dp"
                android:textColor="#E0F7FF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_status_ime_enabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="3dp"
                android:textColor="#E0F7FF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_status_ime_selected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="3dp"
                android:textColor="#E0F7FF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_status_running"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="3dp"
                android:textColor="#E0F7FF"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_overlay"
            style="@style/KeyStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="@string/btn_overlay"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_access"
            style="@style/KeyStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_access"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_ime_enable"
            style="@style/KeyStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_ime_enable"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_ime_pick"
            style="@style/KeyStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_ime_pick"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_toggle"
            style="@style/KeyStyle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/btn_start"
            android:textColor="@color/neon_blue"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/main_hint"
            android:textColor="#8AA7B8"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
