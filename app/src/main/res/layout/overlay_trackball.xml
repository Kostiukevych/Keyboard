<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ball_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Только сам трекбол Orbit X (прозрачный WebView), без рамки и панели тачпада.
         Кнопки управления вызываются двойным нажатием на левую кнопку трекбола. -->
    <WebView
        android:id="@+id/ball_web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Всплывающее контекстное меню ПКМ (.ctx-menu) -->
    <LinearLayout
        android:id="@+id/pad_ctx_menu"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_ctx_menu"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/ctx_refresh"
            style="@style/BarKeyStyle"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="start|center_vertical"
            android:paddingStart="10dp"
            android:text="Обновить      Ctrl+R"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_margin="3dp"
            android:background="#402E7BFF" />

        <TextView
            android:id="@+id/ctx_undo"
            style="@style/BarKeyStyle"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="start|center_vertical"
            android:paddingStart="10dp"
            android:text="Отменить      Ctrl+Z"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ctx_redo"
            style="@style/BarKeyStyle"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="start|center_vertical"
            android:paddingStart="10dp"
            android:text="Повторить     Ctrl+Y"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_margin="3dp"
            android:background="#402E7BFF" />

        <TextView
            android:id="@+id/ctx_cut"
            style="@style/BarKeyStyle"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="start|center_vertical"
            android:paddingStart="10dp"
            android:text="Вырезать      Ctrl+X"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ctx_copy"
            style="@style/BarKeyStyle"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="start|center_vertical"
            android:paddingStart="10dp"
            android:text="Копировать    Ctrl+C"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ctx_paste"
            style="@style/BarKeyStyle"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="start|center_vertical"
            android:paddingStart="10dp"
            android:text="Вставить      Ctrl+V"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ctx_delete"
            style="@style/BarKeyStyle"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="start|center_vertical"
            android:paddingStart="10dp"
            android:text="Удалить       Del"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_margin="3dp"
            android:background="#402E7BFF" />

        <TextView
            android:id="@+id/ctx_select_all"
            style="@style/BarKeyStyle"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="start|center_vertical"
            android:paddingStart="10dp"
            android:text="Выделить всё  Ctrl+A"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
