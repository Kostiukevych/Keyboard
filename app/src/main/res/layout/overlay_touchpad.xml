<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pad_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_neon_panel">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pad_title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:text="⠿ Тачпад"
                android:textColor="#00BFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/pad_btn_lock"
                style="@style/BarKeyStyle"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:text="🔓" />

            <TextView
                android:id="@+id/pad_btn_kb"
                style="@style/BarKeyStyle"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:text="⌨" />

            <TextView
                android:id="@+id/pad_btn_settings"
                style="@style/BarKeyStyle"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:text="⚙" />

            <TextView
                android:id="@+id/pad_btn_close"
                style="@style/BarKeyStyle"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:text="✕" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/pad_btn_left"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_neon_button">

                    <TextView
                        android:id="@+id/pad_left_label"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="ЛКМ"
                        android:textColor="#E0F7FF"
                        android:textSize="14sp" />

                    <ProgressBar
                        android:id="@+id/pad_charge"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_gravity="bottom"
                        android:layout_margin="6dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="#00BFFF" />
                </FrameLayout>

                <TextView
                    android:id="@+id/pad_wheel"
                    style="@style/KeyStyle"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="▲\nКолесо\n▼"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/pad_btn_right"
                    style="@style/KeyStyle"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="ПКМ" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/pad_move_area"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_neon_move_area">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Зона движения"
                    android:textColor="#5500BFFF"
                    android:textSize="13sp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/pad_resize"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="bottom|end"
        android:gravity="bottom|end"
        android:paddingEnd="4dp"
        android:paddingBottom="2dp"
        android:text="◢"
        android:textColor="#00BFFF"
        android:textSize="16sp" />
</FrameLayout>
