<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Клавиатура Neon Keys: нативный View (рисуется на Canvas), высоту задаёт VirtualMouseIME -->
    <com.example.virtualmouse.NeonKeyboardView
        android:id="@+id/kb_neon"
        android:layout_width="match_parent"
        android:layout_height="300dp" />

    <!-- Панель истории буфера обмена (та же, что у классической клавиатуры) -->
    <LinearLayout
        android:id="@+id/kb_clip_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_card_platform"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/kb_clip_title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:text="Буфер обмена"
                android:textColor="@color/acc_soft"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/kb_clip_close"
                style="@style/BarKeyStyle"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:text="✕" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/kb_clip_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <TextView
                android:id="@+id/kb_clip_clear"
                style="@style/BarKeyStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Очистить" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
