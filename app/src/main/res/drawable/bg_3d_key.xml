<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Нажатое состояние клавиши (вдавленная клавиша, смещение вниз) -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#0D141E"
                        android:centerColor="#141E2D"
                        android:endColor="#1C293F" />
                    <stroke
                        android:width="1dp"
                        android:color="#402E7BFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_selected="true">
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#152845"
                        android:centerColor="#1E3760"
                        android:endColor="#2B4E87" />
                    <stroke
                        android:width="1.2dp"
                        android:color="#80A4C6FF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Обычное 3D состояние клавиши: скосы, нижняя подставка и верхний блик -->
    <item>
        <layer-list>
            <!-- Нижняя 3D-грань (глубина) -->
            <item android:top="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#05080E" />
                </shape>
            </item>

            <!-- Лицевая поверхность клавиши -->
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#263750"
                        android:centerColor="#1A2637"
                        android:endColor="#0F1722" />
                    <stroke
                        android:width="0.8dp"
                        android:color="#35FFFFFF" />
                </shape>
            </item>

            <!-- Верхняя светлая фаска -->
            <item
                android:bottom="14dp"
                android:left="2dp"
                android:right="2dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="7dp"
                        android:topRightRadius="7dp"
                        android:bottomLeftRadius="0dp"
                        android:bottomRightRadius="0dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#2AFFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
