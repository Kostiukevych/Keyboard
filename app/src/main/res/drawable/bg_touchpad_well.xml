<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Утопленная внутренняя панель тачпада -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="#121C2C"
                android:centerColor="#080C14"
                android:endColor="#020305" />
            <stroke
                android:width="1.5dp"
                android:color="#452E7BFF" />
        </shape>
    </item>

    <!-- Внутренний верхний контур свечения -->
    <item
        android:left="2dp"
        android:right="2dp"
        android:top="1dp"
        android:bottom="80dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="19dp"
                android:topRightRadius="19dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <gradient
                android:angle="270"
                android:startColor="#1A2E7BFF"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
