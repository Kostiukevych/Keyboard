<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Нажатое состояние стекла -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="1.5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#332E7BFF"
                        android:centerColor="#222E7BFF"
                        android:endColor="#442E7BFF" />
                    <stroke
                        android:width="1.2dp"
                        android:color="#80FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_selected="true">
        <layer-list>
            <item android:top="1.5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#662E7BFF"
                        android:centerColor="#442E7BFF"
                        android:endColor="#882E7BFF" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Обычное состояние стеклянной кнопки -->
    <item>
        <layer-list>
            <!-- Мягкая нижняя тень -->
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <solid android:color="#55000000" />
                </shape>
            </item>

            <!-- Стеклянная поверхность с акцентным свечением -->
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#35FFFFFF"
                        android:centerColor="#122E7BFF"
                        android:endColor="#282E7BFF" />
                    <stroke
                        android:width="1dp"
                        android:color="#45FFFFFF" />
                </shape>
            </item>

            <!-- Верхний блик стекла -->
            <item
                android:bottom="14dp"
                android:left="2dp"
                android:right="2dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="9dp"
                        android:topRightRadius="9dp"
                        android:bottomLeftRadius="0dp"
                        android:bottomRightRadius="0dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#45FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
