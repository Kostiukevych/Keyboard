<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VirtualMouse" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/acc</item>
        <item name="colorPrimaryVariant">#1C5ECC</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>

    <!-- 3D клавиша клавиатуры -->
    <style name="KeyStyle">
        <item name="android:layout_margin">1.5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/txt_main</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@drawable/bg_3d_key</item>
    </style>

    <!-- Стеклянная кнопка панели / переключателя -->
    <style name="BarKeyStyle">
        <item name="android:layout_margin">1.5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:background">@drawable/bg_glass_button</item>
    </style>
</resources>
