<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_neon_panel"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/set_title"
        android:textColor="@color/neon_blue"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_speed"
                android:textColor="#E0F7FF"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/sb_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="32" />

            <TextView
                android:id="@+id/tv_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_size"
                android:textColor="#E0F7FF"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/sb_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="72" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/set_style"
                android:textColor="#E0F7FF"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/st_arrow"
                    style="@style/BarKeyStyle"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/set_style_arrow" />

                <TextView
                    android:id="@+id/st_cross"
                    style="@style/BarKeyStyle"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/set_style_cross" />

                <TextView
                    android:id="@+id/st_dot"
                    style="@style/BarKeyStyle"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/set_style_dot" />

                <TextView
                    android:id="@+id/st_hand"
                    style="@style/BarKeyStyle"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/set_style_hand" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/set_cursor_color"
                android:textColor="#E0F7FF"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/pal_cursor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/set_glow_color"
                android:textColor="#E0F7FF"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/pal_glow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_pad_w"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/set_pad_w"
                android:textColor="#E0F7FF"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/sb_pad_w"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tv_pad_h"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_pad_h"
                android:textColor="#E0F7FF"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/sb_pad_h"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/set_pad_color"
                android:textColor="#E0F7FF"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/pal_pad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/set_key_glow"
                android:textColor="#E0F7FF"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/pal_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <CheckBox
                android:id="@+id/cb_sound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/set_sound"
                android:textColor="#E0F7FF" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_close"
            style="@style/KeyStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/set_close" />

        <TextView
            android:id="@+id/btn_done"
            style="@style/KeyStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/set_done"
            android:textColor="@color/neon_blue"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
