<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VirtualMouse" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#00BFFF</item>
        <item name="colorPrimaryVariant">#0090CC</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:statusBarColor">#0A0E17</item>
        <item name="android:navigationBarColor">#0A0E17</item>
        <item name="android:windowBackground">#0A0E17</item>
    </style>

    <!-- Клавиша клавиатуры: ширина и вес задаются в самой разметке -->
    <style name="KeyStyle">
        <item name="android:layout_margin">1.5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#E0F7FF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:background">@drawable/bg_neon_button</item>
    </style>

    <!-- Кнопка верхней панели клавиатуры -->
    <style name="BarKeyStyle" parent="KeyStyle">
        <item name="android:layout_margin">1dp</item>
        <item name="android:textColor">#00BFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
